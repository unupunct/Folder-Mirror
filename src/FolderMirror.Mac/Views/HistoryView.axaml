<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FolderMirror.Mac.ViewModels"
             x:Class="FolderMirror.Mac.Views.HistoryView">
    <DockPanel Margin="36,30,36,24">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
            <TextBlock Text="History" Classes="title"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Export CSV…" Command="{Binding ExportCsvCommand}"/>
                <Button Content="Clear history" Classes="danger" Command="{Binding ClearCommand}"/>
            </StackPanel>
        </Grid>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="300,200,*" Margin="0,16,0,12">
            <TextBox Text="{Binding Search}" PlaceholderText="Search profile, folder, mode or message"/>
            <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:HistoryViewModel.Statuses}" SelectedItem="{Binding Status}" Margin="10,0,0,0"/>
            <TextBlock Grid.Column="2" Text="{Binding CountText}" Classes="dim" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <Border DockPanel.Dock="Bottom" Classes="card" Height="260" Margin="0,12,0,0" Padding="0" IsVisible="{Binding HasSelection}">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Margin="16,12,16,6" Spacing="2">
                    <TextBlock FontWeight="SemiBold" FontSize="15"><Run Text="{Binding Selected.ProfileName}"/><Run Text="  ·  "/><Run Text="{Binding Selected.Mode}"/><Run Text="  ·  "/><Run Text="{Binding Selected.Trigger}"/></TextBlock>
                    <TextBlock Text="{Binding Selected.Message}" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" FontSize="12.5"/>
                </StackPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Ops}" IsReadOnly="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="100"/>
                        <DataGridTextColumn Header="File" Binding="{Binding RelPath}" Width="3*"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                        <DataGridTextColumn Header="Details" Binding="{Binding Message}" Width="3*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Classes="card" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding Runs}" SelectedItem="{Binding Selected}" IsReadOnly="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Started" Binding="{Binding StartLocal, StringFormat=g}" Width="140"/>
                        <DataGridTextColumn Header="Profile" Binding="{Binding ProfileName}" Width="*" MinWidth="150"/>
                        <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="115"/>
                        <DataGridTextColumn Header="Time" Binding="{Binding DurationText}" Width="70"/>
                        <DataGridTextColumn Header="New" Binding="{Binding FilesCopied}" Width="55"/>
                        <DataGridTextColumn Header="Updated" Binding="{Binding FilesModified}" Width="80"/>
                        <DataGridTextColumn Header="Deleted" Binding="{Binding FilesDeleted}" Width="75"/>
                        <DataGridTextColumn Header="Data" Binding="{Binding BytesText}" Width="80"/>
                        <DataGridTextColumn Header="Errors" Binding="{Binding ErrorCount}" Width="65"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No history matches the current filter." Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEmpty}"/>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
