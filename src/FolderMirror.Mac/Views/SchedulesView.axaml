<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FolderMirror.Mac.Views.SchedulesView">
    <DockPanel Margin="36,30,36,24">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
            <TextBlock Text="Scheduled Tasks" Classes="title"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Paused}" OnContent="Paused" OffContent="Active" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{Binding PausedText}" Classes="dim" TextWrapping="Wrap" Margin="0,0,0,18"/>
        <TextBlock DockPanel.Dock="Top" Text="No profiles yet. Create a profile and give it a schedule in the profile editor." Classes="dim" IsVisible="{Binding IsEmpty}"/>
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="card" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ScheduleText}" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding NextText}" Classes="dim"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Run now" Command="{Binding SyncCommand}"/>
                                    <Button Content="Edit schedule" Command="{Binding EditCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
