<Window x:Class="FolderMirror.Views.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FolderMirror.ViewModels"
        Style="{StaticResource AppWindow}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="../Assets/FolderMirror.ico">
    <StackPanel Margin="30,26,30,24">
        <TextBlock Text="Schedule" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding ProfileName}" Style="{StaticResource Dim}" Margin="0,2,0,16"/>
        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Content="Enable this schedule" Margin="0,0,0,14"/>
        <StackPanel IsEnabled="{Binding Enabled}">
            <TextBlock Text="Repeat" Style="{StaticResource Dim}" Margin="0,0,0,6"/>
            <ComboBox ItemsSource="{x:Static vm:ScheduleViewModel.Kinds}" SelectedItem="{Binding Kind}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumText}}" Foreground="{DynamicResource TextBrush}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Visibility="{Binding ShowTime, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                <TextBlock Text="Time of day (HH:mm)" Style="{StaticResource Dim}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowInterval, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                <TextBlock Text="Repeat every (minutes), from the time above until midnight" Style="{StaticResource Dim}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowDays, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                <TextBlock Text="Days" Style="{StaticResource Dim}" Margin="0,0,0,6"/>
                <WrapPanel>
                    <CheckBox Content="Mon" IsChecked="{Binding Mon}" Margin="0,0,16,0"/><CheckBox Content="Tue" IsChecked="{Binding Tue}" Margin="0,0,16,0"/>
                    <CheckBox Content="Wed" IsChecked="{Binding Wed}" Margin="0,0,16,0"/><CheckBox Content="Thu" IsChecked="{Binding Thu}" Margin="0,0,16,0"/>
                    <CheckBox Content="Fri" IsChecked="{Binding Fri}" Margin="0,0,16,0"/><CheckBox Content="Sat" IsChecked="{Binding Sat}" Margin="0,0,16,0"/>
                    <CheckBox Content="Sun" IsChecked="{Binding Sun}"/>
                </WrapPanel>
            </StackPanel>
            <TextBlock Text="Also run" Style="{StaticResource Dim}" Margin="0,16,0,4"/>
            <CheckBox Content="When Windows starts" IsChecked="{Binding AtStartup}"/>
            <CheckBox Content="When I sign in" IsChecked="{Binding AtLogon}"/>
            <CheckBox Content="Only run when the source and destination are available" IsChecked="{Binding OnlyWhenAvailable}" Margin="0,12,0,0"/>
            <StackPanel Visibility="{Binding ShowDeletions, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                <CheckBox IsChecked="{Binding AllowDeletions}"><TextBlock TextWrapping="Wrap" MaxWidth="440" Text="Allow scheduled runs to remove files (archived or deleted according to the profile). When off, scheduled runs copy but skip deletions."/></CheckBox>
            </StackPanel>
        </StackPanel>
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DeleteBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="96" Margin="0,0,10,0" IsCancel="True"/>
            <Button Content="Save schedule" Command="{Binding SaveCommand}" MinWidth="130" Style="{StaticResource AccentButton}" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
