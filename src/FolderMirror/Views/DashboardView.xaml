<UserControl x:Class="FolderMirror.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:FolderMirror.Services">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,30">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding [dash.title], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding [tagline], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource Dim}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AccentButton}" Padding="22,10" Command="{Binding NewSyncCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Foreground="{DynamicResource AccentFgBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding [dash.new], Source={x:Static svc:Loc.Instance}}" Foreground="{DynamicResource AccentFgBrush}" FontSize="14"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Stat tiles -->
            <UniformGrid Columns="4" Margin="0,24,-14,0">
                <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding [dash.profiles], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource Dim}"/></StackPanel>
                        <TextBlock Text="{Binding ProfileCount}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Foreground="{DynamicResource ModifiedBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding [dash.files], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource Dim}"/></StackPanel>
                        <TextBlock Text="{Binding FilesText}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" Foreground="{DynamicResource ConflictBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding [dash.last], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource Dim}"/></StackPanel>
                        <TextBlock Text="{Binding LastText}" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE787;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding [dash.next], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource Dim}"/></StackPanel>
                        <TextBlock Text="{Binding NextText}" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Status -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding [dash.status], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Coordinator.StatusText}" Margin="0,8,0,0" FontSize="14"/>
                        <StackPanel Visibility="{Binding Coordinator.IsBusy, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Margin="0,12,0,8" Maximum="100" Value="{Binding Coordinator.Fraction, Mode=OneWay}" IsIndeterminate="{Binding Coordinator.IsIndeterminate}"/>
                            <TextBlock Text="{Binding Coordinator.CurrentFile}" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                            <TextBlock Text="{Binding Coordinator.DetailText}" Style="{StaticResource Dim}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" VerticalAlignment="Center" Visibility="{Binding Coordinator.IsRunning, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>

            <!-- Profiles -->
            <TextBlock Text="{Binding [dash.saved], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource SectionTitle}" Margin="0,28,0,12"/>
            <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource ProfileCardTemplate}" Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <Border Style="{StaticResource Card}" Padding="28" Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="34" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="No synchronization profiles yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="Create your first profile to keep two folders in sync. You will always see a preview before anything is changed." Style="{StaticResource Dim}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460"/>
                    <Button Content="Create a profile" Style="{StaticResource AccentButton}" Command="{Binding NewSyncCommand}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <!-- Recent -->
            <Grid Margin="0,16,0,12">
                <TextBlock Text="{Binding [dash.recent], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource SectionTitle}"/>
                <Button Content="View all" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Command="{Binding ShowHistoryCommand}" MinHeight="26" Padding="10,2"/>
            </Grid>
            <Border Style="{StaticResource Card}" Padding="4,6">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Recent}" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="14,9">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" HorizontalAlignment="Left"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource Dim}" FontSize="12">
                                            <Run Text="{Binding FilesCopied, Mode=OneWay}"/> new · <Run Text="{Binding FilesModified, Mode=OneWay}"/> updated · <Run Text="{Binding FilesDeleted, Mode=OneWay}"/> deleted · <Run Text="{Binding BytesText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Status, Converter={StaticResource EnumText}}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding StartLocal, StringFormat=g}" Style="{StaticResource Dim}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Nothing has been synchronized yet." Style="{StaticResource Dim}" Margin="14,12" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
