<Window x:Class="FolderMirror.Views.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FolderMirror.ViewModels"
        xmlns:core="clr-namespace:FolderMirror.Core.Models;assembly=FolderMirror.Core"
        Style="{StaticResource AppWindow}"
        Width="840" Height="740" MinHeight="620" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="../Assets/FolderMirror.ico">
    <Window.Resources>
        <Style x:Key="StepDot" TargetType="Border">
            <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
        </Style>
        <DataTemplate x:Key="EnumItem"><TextBlock Text="{Binding Converter={StaticResource EnumText}}" Foreground="{DynamicResource TextBrush}"/></DataTemplate>
    </Window.Resources>
    <DockPanel Margin="32,26,32,22">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource Dim}" FontSize="12"/>
            <TextBlock Text="{Binding StepTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,14"/>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Height="4" CornerRadius="2" Margin="0,0,6,0" Background="{DynamicResource AccentBrush}"/>
                <Border Grid.Column="1" Height="4" CornerRadius="2" Margin="0,0,6,0"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface2Brush}"/><Style.Triggers><DataTrigger Binding="{Binding Step}" Value="2"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></DataTrigger><DataTrigger Binding="{Binding Step}" Value="3"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></DataTrigger><DataTrigger Binding="{Binding Step}" Value="4"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
                <Border Grid.Column="2" Height="4" CornerRadius="2" Margin="0,0,6,0"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface2Brush}"/><Style.Triggers><DataTrigger Binding="{Binding Step}" Value="3"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></DataTrigger><DataTrigger Binding="{Binding Step}" Value="4"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
                <Border Grid.Column="3" Height="4" CornerRadius="2"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface2Brush}"/><Style.Triggers><DataTrigger Binding="{Binding Step}" Value="4"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
            </Grid>
        </StackPanel>

        <!-- Footer -->
        <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Left" MinWidth="100" IsCancel="True"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Back" Command="{Binding BackCommand}" MinWidth="100" Margin="0,0,10,0" Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                <Button Content="Next" Command="{Binding NextCommand}" MinWidth="120" Style="{StaticResource AccentButton}" IsEnabled="{Binding CanNext}" Visibility="{Binding IsLast, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                <Button Content="Save profile" Command="{Binding SaveCommand}" MinWidth="140" Style="{StaticResource AccentButton}" IsEnabled="{Binding Reviewed}" Visibility="{Binding IsLast, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Step 1 -->
                <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Profile name" Style="{StaticResource Dim}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Source folder" Style="{StaticResource Dim}" Margin="0,18,0,6"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseSourceCommand}" Margin="8,0,0,0" MinWidth="100"/>
                    </Grid>
                    <TextBlock Text="{Binding SourceSpace}" Style="{StaticResource Dim}" FontSize="12" Margin="2,5,0,0"/>
                    <TextBlock Text="Destination folder" Style="{StaticResource Dim}" Margin="0,16,0,6"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseDestinationCommand}" Margin="8,0,0,0" MinWidth="100"/>
                    </Grid>
                    <TextBlock Text="{Binding DestinationSpace}" Style="{StaticResource Dim}" FontSize="12" Margin="2,5,0,0"/>
                    <TextBlock Style="{StaticResource Dim}" FontSize="12" Margin="0,14,0,10" TextWrapping="Wrap" Text="Local drives, external USB drives and network shares (such as \\server\share or a mapped drive) are all supported. Network access uses your current Windows sign-in; Folder Mirror never stores passwords."/>
                    <ItemsControl ItemsSource="{Binding Issues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Severity, Converter={StaticResource SeverityGlyph}}" VerticalAlignment="Top" Margin="0,1,12,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Step 2 -->
                <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                    <RadioButton Style="{StaticResource CardRadio}" GroupName="Mode" IsChecked="{Binding Mode, Converter={x:Static vm:ModeRadio.Instance}, ConverterParameter=Mirror}">
                        <StackPanel><TextBlock Text="Mirror" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Destination becomes an exact copy of the source. New and changed files are copied; files that no longer exist in the source are removed from the destination (moved to a dated archive by default). You always get a preview and a deletion warning first." Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,26,0"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource CardRadio}" GroupName="Mode" IsChecked="{Binding Mode, Converter={x:Static vm:ModeRadio.Instance}, ConverterParameter=OneWay}">
                        <StackPanel><TextBlock Text="One-way sync" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Copies new and modified files from the source to the destination. Nothing is ever deleted from the destination." Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,26,0"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource CardRadio}" GroupName="Mode" IsChecked="{Binding Mode, Converter={x:Static vm:ModeRadio.Instance}, ConverterParameter=TwoWay}">
                        <StackPanel><TextBlock Text="Two-way sync" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Changes made on either side are carried to the other, including deletions. A local database tracks the previous state, so files changed on both sides are reported as conflicts instead of being overwritten." Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,26,0"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource CardRadio}" GroupName="Mode" IsChecked="{Binding Mode, Converter={x:Static vm:ModeRadio.Instance}, ConverterParameter=Incremental}">
                        <StackPanel><TextBlock Text="Incremental backup" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Copies only new or modified files and keeps every previous version of an overwritten file in a versions folder. Nothing is deleted automatically." Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,26,0"/></StackPanel>
                    </RadioButton>
                    <StackPanel Visibility="{Binding ShowConflictOption, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                        <TextBlock Text="When a file changed on both sides" Style="{StaticResource Dim}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{x:Static vm:WizardViewModel.ConflictPolicies}" SelectedItem="{Binding ConflictPolicy}" ItemTemplate="{StaticResource EnumItem}"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding ShowDeletionOption, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                        <TextBlock Text="Files that must be removed" Style="{StaticResource Dim}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{x:Static vm:WizardViewModel.DeletionBehaviors}" SelectedItem="{Binding DeletionBehavior}" ItemTemplate="{StaticResource EnumItem}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Step 3 -->
                <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="What to synchronize" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <CheckBox Content="Include subdirectories" IsChecked="{Binding IncludeSubdirectories}"/>
                    <CheckBox Content="Preserve file timestamps" IsChecked="{Binding PreserveTimestamps}"/>
                    <CheckBox Content="Preserve file attributes (read-only, hidden, system, archive)" IsChecked="{Binding PreserveAttributes}"/>
                    <TextBlock Text="How to decide a file changed" Style="{StaticResource SectionTitle}" Margin="0,16,0,6"/>
                    <CheckBox Content="Compare file sizes" IsChecked="{Binding CompareSize}"/>
                    <CheckBox Content="Compare modification dates" IsChecked="{Binding CompareDate}"/>
                    <CheckBox Content="Compare content with SHA-256 (slower, most accurate)" IsChecked="{Binding CompareHash}"/>
                    <TextBlock Text="Ignore" Style="{StaticResource SectionTitle}" Margin="0,16,0,6"/>
                    <UniformGrid Columns="2">
                        <CheckBox Content="Hidden files" IsChecked="{Binding IgnoreHidden}"/>
                        <CheckBox Content="System files" IsChecked="{Binding IgnoreSystem}"/>
                        <CheckBox Content="Temporary files (.tmp, ~$…, Thumbs.db)" IsChecked="{Binding IgnoreTemp}"/>
                        <CheckBox Content="Empty folders" IsChecked="{Binding IgnoreEmpty}"/>
                    </UniformGrid>
                    <TextBlock Text="Exclude extensions (separated by commas, e.g. .log, .bak)" Style="{StaticResource Dim}" Margin="0,16,0,6"/>
                    <TextBox Text="{Binding ExcludedExtensions, UpdateSourceTrigger=PropertyChanged}"/>
                    <Grid Margin="0,16,0,6"><TextBlock Text="Exclude folders (one per line: a folder name or a path relative to the source)" Style="{StaticResource Dim}"/><Button Content="Add folder…" Command="{Binding AddExcludedFolderCommand}" HorizontalAlignment="Right" MinHeight="26" Padding="12,2"/></Grid>
                    <TextBox Text="{Binding ExcludedFolders, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80" VerticalContentAlignment="Top" TextWrapping="Wrap"/>
                    <TextBlock Text="Safety" Style="{StaticResource SectionTitle}" Margin="0,16,0,6"/>
                    <CheckBox Content="Verify every copied file with SHA-256" IsChecked="{Binding Verify}"/>
                    <CheckBox Content="Keep a backup of destination files that get overwritten" IsChecked="{Binding BackupOverwritten}" Visibility="{Binding ShowBackupOption, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <!-- Step 4 -->
                <StackPanel Visibility="{Binding IsStep4, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}" Padding="20,16">
                        <TextBlock Text="{Binding ReviewText}" TextWrapping="Wrap" LineHeight="24" FontFamily="Segoe UI Variable Text, Segoe UI"/>
                    </Border>
                    <Border Background="{DynamicResource WarnBgBrush}" CornerRadius="8" Padding="14,10" Margin="0,14,0,0" Visibility="{Binding IsMirror, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" Text="Mirror mode removes files from the destination that are not in the source. Before every run you will see a preview and must confirm the deletions. Scheduled runs only delete if you explicitly allow it in the schedule."/>
                    </Border>
                    <CheckBox Margin="0,18,0,0" IsChecked="{Binding Reviewed}"><TextBlock Text="I have reviewed these settings and want to save this profile." TextWrapping="Wrap"/></CheckBox>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
