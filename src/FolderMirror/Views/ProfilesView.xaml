<UserControl x:Class="FolderMirror.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:FolderMirror.Services">
    <DockPanel Margin="36,30,36,24">
        <Grid DockPanel.Dock="Top">
            <TextBlock Text="{Binding [profiles.title], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource PageTitle}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding ImportCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="{Binding [btn.import], Source={x:Static svc:Loc.Instance}}"/></StackPanel>
                </Button>
                <Button Command="{Binding ExportAllCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE898;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Export all"/></StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButton}" Command="{Binding NewCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Foreground="{DynamicResource AccentFgBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding [btn.new], Source={x:Static svc:Loc.Instance}}" Foreground="{DynamicResource AccentFgBrush}"/></StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
            <Grid>
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding ModeGlyph}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" FontSize="20"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                            <Border Style="{StaticResource Chip}" Background="{DynamicResource Surface2Brush}" Margin="10,0,0,0"><TextBlock Text="{Binding ModeTitle}" FontSize="11" Style="{StaticResource Dim}"/></Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Dim}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"><Run Text="From  "/><Run Text="{Binding Source, Mode=OneWay}" Foreground="{DynamicResource TextBrush}"/></TextBlock>
                                        <TextBlock Style="{StaticResource Dim}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"><Run Text="To      "/><Run Text="{Binding Destination, Mode=OneWay}" Foreground="{DynamicResource TextBrush}"/></TextBlock>
                                        <TextBlock Style="{StaticResource Dim}" FontSize="12" Margin="0,6,0,0"><Run Text="Last run: "/><Run Text="{Binding LastSyncText, Mode=OneWay}"/><Run Text="   ·   Schedule: "/><Run Text="{Binding ScheduleText, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource AccentButton}" Command="{Binding RunCommand}" Margin="0,0,8,0" MinWidth="80" Content="{Binding [btn.run], Source={x:Static svc:Loc.Instance}}"/>
                                        <Button Command="{Binding EditCommand}" Margin="0,0,6,0" Content="{Binding [btn.edit], Source={x:Static svc:Loc.Instance}}"/>
                                        <Button Command="{Binding EditScheduleCommand}" Margin="0,0,6,0" ToolTip="Schedule this profile"><TextBlock Style="{StaticResource Icon}" Text="&#xE787;" FontSize="14"/></Button>
                                        <Button Command="{Binding DuplicateCommand}" Margin="0,0,6,0" ToolTip="Duplicate profile"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="14"/></Button>
                                        <Button Command="{Binding ExportCommand}" Margin="0,0,6,0" ToolTip="Export this profile"><TextBlock Style="{StaticResource Icon}" Text="&#xE898;" FontSize="14"/></Button>
                                        <Button Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" ToolTip="Delete profile"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Foreground="{DynamicResource DeleteBrush}"/></Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel HorizontalAlignment="Center" Margin="0,80,0,0" Visibility="{Binding HasCards, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="40" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="No profiles yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="Create a profile with the wizard, or import profiles exported from another computer." Style="{StaticResource Dim}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
