<UserControl x:Class="FolderMirror.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:FolderMirror.Services"
             xmlns:vm="clr-namespace:FolderMirror.ViewModels">
    <Grid Margin="36,30,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding [sync.title], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource PageTitle}"/>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Width="320" IsEnabled="{Binding Coordinator.IsBusy, Converter={StaticResource InverseBool}}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Margin="10,0,0,0" Command="{Binding PreviewCommand}" MinWidth="120">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="{Binding [btn.preview], Source={x:Static svc:Loc.Instance}}"/></StackPanel>
            </Button>
            <Button Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource AccentButton}" Command="{Binding StartCommand}" MinWidth="190">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Foreground="{DynamicResource AccentFgBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding [btn.start], Source={x:Static svc:Loc.Instance}}" Foreground="{DynamicResource AccentFgBrush}"/></StackPanel>
            </Button>
            <Button Grid.Column="4" Content="{Binding [btn.cancel], Source={x:Static svc:Loc.Instance}}" Command="{Binding CancelCommand}" MinWidth="100"
                    Visibility="{Binding Coordinator.IsRunning, Converter={StaticResource BoolToVis}}"/>
            <Button Grid.Column="4" Content="Clear preview" Command="{Binding ClearPreviewCommand}" Style="{StaticResource GhostButton}"
                    Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- Banners -->
        <StackPanel Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Issues}" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Severity, Converter={StaticResource SeverityGlyph}}" VerticalAlignment="Top" Margin="0,1,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Progress -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding Coordinator.IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding Coordinator.StatusText}" FontSize="15" FontWeight="SemiBold"/>
                    <ProgressBar Margin="0,12,0,10" Height="10" Maximum="100" Value="{Binding Coordinator.Fraction, Mode=OneWay}" IsIndeterminate="{Binding Coordinator.IsIndeterminate}"/>
                    <TextBlock Text="{Binding Coordinator.CurrentFile}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Coordinator.DetailText}" Style="{StaticResource Dim}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- Result -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="20" Margin="0,0,12,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Text" Value="&#xE73E;"/><Setter Property="Foreground" Value="{DynamicResource NewBrush}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding ResultIsError}" Value="True"><Setter Property="Text" Value="&#xE7BA;"/><Setter Property="Foreground" Value="{DynamicResource ConflictBrush}"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding ResultText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="900" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding ResultErrors}" Margin="32,8,0,0">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource ConflictBrush}" Margin="0,2" FontSize="12.5"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Plan summary -->
        <StackPanel Grid.Row="3" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding PlanHeader}" Style="{StaticResource Dim}" Margin="0,14,0,10" FontSize="12"/>
            <UniformGrid Columns="7" Margin="0,0,-8,0">
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,8,0"><StackPanel><TextBlock Text="To copy" Style="{StaticResource Dim}" FontSize="11"/><TextBlock Text="{Binding SumCopy}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource NewBrush}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,8,0"><StackPanel><TextBlock Text="To update" Style="{StaticResource Dim}" FontSize="11"/><TextBlock Text="{Binding SumUpdate}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource ModifiedBrush}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,8,0"><StackPanel><TextBlock Text="To delete" Style="{StaticResource Dim}" FontSize="11"/><TextBlock Text="{Binding SumDelete}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource DeleteBrush}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,8,0"><StackPanel><TextBlock Text="Unchanged" Style="{StaticResource Dim}" FontSize="11"/><TextBlock Text="{Binding SumUnchanged}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource UnchangedBrush}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,8,0"><StackPanel><TextBlock Text="Conflicts" Style="{StaticResource Dim}" FontSize="11"/><TextBlock Text="{Binding SumConflict}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource ConflictBrush}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,8,0"><StackPanel><TextBlock Text="Transfer" Style="{StaticResource Dim}" FontSize="11"/><TextBlock Text="{Binding SumTransfer}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,8,0"><StackPanel><TextBlock Text="Free space" Style="{StaticResource Dim}" FontSize="11"/><TextBlock Text="{Binding SumSpace}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
            </UniformGrid>

            <!-- Filters -->
            <Grid Margin="0,14,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by file name or path"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding ShowNew}" Margin="0,0,16,0"><TextBlock Text="New" Foreground="{DynamicResource NewBrush}"/></CheckBox>
                    <CheckBox IsChecked="{Binding ShowModified}" Margin="0,0,16,0"><TextBlock Text="Modified" Foreground="{DynamicResource ModifiedBrush}"/></CheckBox>
                    <CheckBox IsChecked="{Binding ShowDelete}" Margin="0,0,16,0"><TextBlock Text="Deleted" Foreground="{DynamicResource DeleteBrush}"/></CheckBox>
                    <CheckBox IsChecked="{Binding ShowUnchanged}" Margin="0,0,16,0"><TextBlock Text="Unchanged" Foreground="{DynamicResource UnchangedBrush}"/></CheckBox>
                    <CheckBox IsChecked="{Binding ShowConflict}"><TextBlock Text="Conflicts" Foreground="{DynamicResource ConflictBrush}"/></CheckBox>
                </StackPanel>
            </Grid>

                <StackPanel HorizontalAlignment="Right" Margin="0,0,0,10" Orientation="Horizontal" Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Resolve all conflicts:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Dim}"/>
                    <ComboBox ItemsSource="{x:Static vm:SyncViewModel.Resolutions}" SelectedItem="{Binding BulkResolution}" Width="170">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumText}}" Foreground="{DynamicResource TextBrush}"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Apply" Command="{Binding ApplyBulkResolutionCommand}" Margin="8,0,0,0"/>
                </StackPanel>


        </StackPanel>

        <!-- Plan table / empty state -->
        <Grid Grid.Row="4">
            <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
                <DataGrid x:Name="PlanGrid" ItemsSource="{Binding PlanView}" Margin="4" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Action" Width="130" SortMemberPath="ActionText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding Reason}">
                                        <Ellipse Width="10" Height="10" Fill="{Binding Action, Converter={StaticResource ActionBrush}}" Margin="0,0,9,0"/>
                                        <TextBlock Text="{Binding ActionText}" Foreground="{Binding Action, Converter={StaticResource ActionBrush}}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding DirectionText}" Margin="8,0,0,0" Style="{StaticResource Dim}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="File" Width="2*" SortMemberPath="RelPath">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RelPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Source" Binding="{Binding SourcePath}" Width="2*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource Dim}"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Destination" Binding="{Binding DestinationPath}" Width="2*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource Dim}"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" SortMemberPath="Size">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Resolution" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{x:Static vm:SyncViewModel.Resolutions}" SelectedItem="{Binding Resolution}" MinHeight="28" Padding="0"
                                              Visibility="{Binding Action, Converter={StaticResource ConflictVis}}" SelectionChanged="Resolution_Changed">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumText}}" Foreground="{DynamicResource TextBrush}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasPlan}" Value="False"/>
                                    <Condition Binding="{Binding Coordinator.IsBusy}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" FontSize="40" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Preview before you synchronize" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,6"/>
                <TextBlock Text="Choose a profile and press Preview. Folder Mirror reads the real folders and lists every file it would copy, update or delete. Nothing is changed until you press Start Synchronization." Style="{StaticResource Dim}" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
