<UserControl x:Class="FolderMirror.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:FolderMirror.Services">
    <DockPanel Margin="36,30,36,24">
        <Grid DockPanel.Dock="Top">
            <TextBlock Text="{Binding [hist.title], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource PageTitle}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding ExportCsvCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE898;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Export CSV"/></StackPanel>
                </Button>
                <Button Command="{Binding ClearCommand}" Style="{StaticResource DangerButton}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Foreground="{DynamicResource DeleteBrush}" Margin="0,0,8,0"/><TextBlock Text="Clear history" Foreground="{DynamicResource DeleteBrush}"/></StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <Grid DockPanel.Dock="Top" Margin="0,18,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search profile, folder, mode or message"/>
            <ComboBox Grid.Column="1" Margin="10,0,0,0" Width="190" ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumText}}" Foreground="{DynamicResource TextBrush}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="2" Margin="10,0,0,0" Width="140" ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}"/>
            <TextBlock Grid.Column="3" Text="{Binding CountText}" Style="{StaticResource Dim}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Details -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Height="300" Margin="0,12,0,0" Padding="16,12" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold"><Run Text="{Binding Selected.ProfileName, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Selected.Mode, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Selected.Trigger, Mode=OneWay}"/></TextBlock>
                        <TextBlock Style="{StaticResource Dim}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"><Run Text="{Binding Selected.Source, Mode=OneWay}"/><Run Text="  →  "/><Run Text="{Binding Selected.Destination, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                    <Button Content="Export report" Command="{Binding ExportReportCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" MinHeight="28" Padding="12,3"/>
                </Grid>
                <TextBlock Grid.Row="1" Margin="0,6,0,8" TextWrapping="Wrap" Text="{Binding Selected.Message}" Foreground="{DynamicResource ConflictBrush}" Visibility="{Binding Selected.Message, Converter={StaticResource NullToCollapsed}}"/>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBox Text="{Binding OpFilter, UpdateSourceTrigger=PropertyChanged}" Width="260" HorizontalAlignment="Left" MinHeight="30" Padding="8,4" Margin="0,4,0,6" ToolTip="Filter operations by file, action or status"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Ops}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="100">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Action, Converter={StaticResource OpActionBrush}}"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="File" Binding="{Binding RelPath}" Width="3*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Status, Converter={StaticResource StatusBrush}}"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Details" Binding="{Binding Message}" Width="3*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding Runs}" SelectedItem="{Binding Selected}" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Started" Binding="{Binding StartLocal, StringFormat=g}" Width="150"/>
                        <DataGridTextColumn Header="Profile" Binding="{Binding ProfileName}" Width="2*" MinWidth="170"/>
                        <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="125"/>
                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="90"/>
                        <DataGridTextColumn Header="New" Binding="{Binding FilesCopied}" Width="60"/>
                        <DataGridTextColumn Header="Updated" Binding="{Binding FilesModified}" Width="75"/>
                        <DataGridTextColumn Header="Deleted" Binding="{Binding FilesDeleted}" Width="70"/>
                        <DataGridTextColumn Header="Data" Binding="{Binding BytesText}" Width="90"/>
                        <DataGridTextColumn Header="Errors" Binding="{Binding ErrorCount}" Width="65"/>
                        <DataGridTemplateColumn Header="Status" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Status, Converter={StaticResource EnumText}}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No history matches the current filter." Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Runs.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
