<Window x:Class="FolderMirror.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        SizeToContent="Height" Width="520" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="28,26,28,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="IconText" Style="{StaticResource Icon}" FontSize="26" Margin="0,0,14,0" VerticalAlignment="Top"/>
            <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="400" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,14,0,0" TextWrapping="Wrap" Style="{StaticResource Dim}" LineHeight="20"/>
        <StackPanel x:Name="CheckPanel" Grid.Row="2" Margin="0,16,0,0" Visibility="Collapsed">
            <CheckBox x:Name="Check"><TextBlock x:Name="CheckText" TextWrapping="Wrap" MaxWidth="420"/></CheckBox>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="96" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="OkButton" Content="OK" MinWidth="110" Style="{StaticResource AccentButton}" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
