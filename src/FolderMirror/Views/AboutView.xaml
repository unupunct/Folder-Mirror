<UserControl x:Class="FolderMirror.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:FolderMirror.Services">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,30" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{Binding [about.title], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource PageTitle}"/>
            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="28">
                <StackPanel Orientation="Horizontal">
                    <Image Source="../Assets/logo.png" Width="112" Height="112" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="24,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding [tagline], Source={x:Static svc:Loc.Instance}}" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Version}" Style="{StaticResource Dim}" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding Copyright}" Style="{StaticResource Dim}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="About this product" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Style="{StaticResource Dim}" Margin="0,8,0,0" LineHeight="21"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Product information" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Runtime" Style="{StaticResource Dim}"/><TextBlock Grid.Column="1" Text="{Binding Runtime}" TextWrapping="Wrap"/></Grid>
                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Data folder" Style="{StaticResource Dim}"/><TextBlock Grid.Column="1" Text="{Binding DataFolder}" TextWrapping="Wrap"/></Grid>
                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Log folder" Style="{StaticResource Dim}"/><TextBlock Grid.Column="1" Text="{Binding LogFolder}" TextWrapping="Wrap"/></Grid>
                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Storage" Style="{StaticResource Dim}"/><TextBlock Grid.Column="1" Text="SQLite (profiles, history, sync state) · works fully offline" TextWrapping="Wrap"/></Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Open data folder" Command="{Binding OpenDataCommand}" Margin="0,0,8,0"/>
                        <Button Content="Open log folder" Command="{Binding OpenLogsCommand}" Margin="0,0,8,0"/>
                        <Button Content="Project page on GitHub" Command="{Binding OpenRepoCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
